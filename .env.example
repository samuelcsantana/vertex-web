NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Local-development override for the site's own origin, which every absolute
# URL is built from (canonical, og:url, metadataBase, sitemap, robots). The
# real value is a constant in src/lib/site-url.ts, and that constant wins in
# production builds no matter what this is set to — deliberately, so that a
# missing or stale deployment variable can never decide what the published
# site calls itself. Setting it here only makes locally generated URLs point
# at the dev server instead of the live domain. Do not set it in deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3021"

# Base URL of the vertex-api backend, server-only. Server Actions/Components
# forward the HttpOnly access_token cookie to this URL directly.
VERTEX_API_URL="http://localhost:3020"

# Same backend URL, but browser-readable — used by Client Components that
# open OAuth popups directly (Google/GitHub login, GitHub account linking).
# Google/GitHub login redirects the popup to this app's own /auth/callback
# with a short-lived, single-use exchange code (never the real token) in
# the URL instead of vertex-api setting the cookie itself, since vertex-api
# and this app live on different domains and a cookie set by vertex-api's
# own response would be scoped to its domain, not this app's — see
# src/app/[locale]/auth/callback and exchangeOAuthCodeAction.
NEXT_PUBLIC_VERTEX_API_URL="http://localhost:3020"

# Public base URL of the S3 bucket vertex-api presigns media uploads for
# (covers, inline post images, avatars). Feeds next.config.ts's
# images.remotePatterns allowlist, so next/image only optimizes our own
# bucket's images — cover URLs pasted from arbitrary hosts keep rendering as
# a plain <img> (see src/features/posts/components/CoverImage.tsx). Leaving
# it unset just disables the optimizer path entirely (everything falls back
# to <img>). Read at build time: set it in the deployment platform's env,
# not only at runtime.
NEXT_PUBLIC_MEDIA_BASE_URL="https://blog-dev-apps.s3.sa-east-1.amazonaws.com"
